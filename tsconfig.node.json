{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "types": ["node"]
  },
  // Tests of build-time code live with build-time code, so the zod schemas
  // stay out of the app project and can never be pulled into the bundle.
  "include": [
    "scripts",
    "tests/node",
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
